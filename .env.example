# Copy this to .env and fill in your values

# Optional: Gemini API key for fun AI commentary on matches
# Get one at https://aistudio.google.com/app/apikey
LLM_API_KEY=

# Optional: model to use for commentary (default: gemini-1.5-flash)
LLM_MODEL=gemini-1.5-flash

# Optional: number of top matches to return (default: 5)
TOP_K=5

# Optional: InsightFace model name (default: buffalo_l)
INSIGHTFACE_MODEL=buffalo_l
