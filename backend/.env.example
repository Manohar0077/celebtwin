# Optional: Gemini API key for commentary
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
TOP_K=5
INSIGHTFACE_MODEL=buffalo_sc

# Optional: Telegram bot to receive captured user snapshots
# 1. Create a bot with @BotFather on Telegram to get your token
# 2. Get your Chat ID with @userinfobot or @raw_data_bot on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
